# Template de .env para o deploy real em produção (VPS). NÃO reaproveite o .env de desenvolvimento —
# ele tem APP_ENV=local, APP_DEBUG=true e senhas fracas, o que expõe stack traces completos e dados
# sensíveis se usado em produção. Ver a seção "Production deploy" do CLAUDE.md.
#
# Uso: copie este arquivo para `.env` na raiz do projeto no servidor (docker compose lê `.env`, não
# `.env.production`), preencha todos os valores marcados como CHANGE_ME, e rode
# `php artisan key:generate` no container pra gerar a APP_KEY.

APP_NAME="Mr. Bills"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME.example.com

APP_SERVICE=core
APP_DOMAIN=CHANGE_ME.example.com
ACME_EMAIL=CHANGE_ME@example.com

# E-mail que recebe o alerta quando algum job cai em failed_jobs (ver AlertFailedJobs).
ADMIN_EMAIL=CHANGE_ME@example.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

WWWGROUP=1000
WWWUSER=1000

# Nunca "debug"/"develop" em produção — a extensão fica instalada na imagem, mas deve ficar desligada.
SAIL_XDEBUG_MODE=off

# Warning (não "debug") evita logar payloads/queries verbosos em produção; daily+retenção evita o log
# crescer sem limite no disco do host.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=mrbills
DB_USERNAME=sail
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Garante o cookie de sessão só trafegando por HTTPS, sem depender só da inferência automática de
# esquema via X-Forwarded-Proto (ver trustProxies em bootstrap/app.php).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=rabbitmq

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=mrbills
RABBITMQ_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
RABBITMQ_VHOST=/
# Não publicar essas portas em produção (compose.prod.yaml não inclui compose.override.yaml, então elas
# já ficam fora do host por padrão — só documentando a intenção).
# FORWARD_RABBITMQ_PORT / FORWARD_RABBITMQ_DASHBOARD_PORT não se aplicam aqui.

CACHE_STORE=database

# E-mail transacional real via Resend (necessário pra verificação de e-mail e reset de senha
# funcionarem — com MAIL_MAILER=log, como no .env de dev, esses fluxos ficam travados pro usuário).
MAIL_MAILER=resend
RESEND_KEY=CHANGE_ME
MAIL_FROM_ADDRESS="CHANGE_ME@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
